NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
APP_URL=http://localhost:3005
# local | staging | production. Production mode validates required settings and HTTPS.
DEPLOYMENT_ENV=local
# Required for dynamic profession job saves and platform admin actions. Server only.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. At least 32 random characters in production.
RATE_LIMIT_HMAC_KEY=
# Enable only after applying the analytics migration and reviewing the privacy notice.
ANALYTICS_ENABLED=false
# Web UX flag only. Close signup_settings.enabled and enable the Auth hook for provider-wide closure.
PUBLIC_SIGNUPS_ENABLED=true
# Trust custom proxy-written IP headers only if the proxy strips client-supplied values.
# Vercel uses its own rewritten forwarding header automatically.
TRUST_PROXY_IP_HEADERS=false
# Public verification and legal identity; provide real values before production.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
# Set true only after a qualified review of the real operator and data flows.
LEGAL_REVIEW_APPROVED=false
