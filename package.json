{
  "name": "kacayapayim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/mobile",
    "packages/core"
  ],
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start -p 3005",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:database": "node scripts/test-database.mjs",
    "verify": "npm test && npm run test:database && npm run typecheck && npm run mobile:typecheck && npm run lint -w @kacayapayim/mobile && npm run build",
    "smoke": "node scripts/smoke-production.mjs",
    "mobile": "npm run start -w @kacayapayim/mobile",
    "mobile:typecheck": "npm run typecheck -w @kacayapayim/mobile"
  },
  "dependencies": {
    "@kacayapayim/core": "file:packages/core",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "decode-uri-component": "0.5.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.27",
    "pdf-lib": "^1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.35.5",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    },
    "decode-uri-component": "0.5.0",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
